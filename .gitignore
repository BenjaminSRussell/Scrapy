*.parquet
*.avro

# Grafana dashboard exports are source-controlled config, not generated
# data - *.json above would otherwise silently exclude them (this is
# exactly how monitoring/dashboards/unified_dashboard.json went missing).
!Scraping_project/monitoring/dashboards/*.json
# The Helm chart's copies of them (Helm can only read files inside the chart, #157).
!Scraping_project/k8s/helm/scraping-pipeline/files/monitoring/dashboards/*.json
# Dev container definition (#694).
!.devcontainer/devcontainer.json

# ====================================
# Jupyter Notebook
# ====================================
.ipynb_checkpoints

# ====================================
# Cache Directories
# ====================================
.ruff_cache/
.mypy_cache/

# ====================================
# Whitelisted Files (Keep These!)
# ====================================
!package.json
!package-lock.json
!tsconfig.json
!Cargo.toml
!Cargo.lock

# ====================================
# Crawl artifacts (#797): screenshots, WARC archives, profiler dumps, exports.
# Scraping_project/data/config/ and tests/**/fixtures/ stay tracked.
# ====================================
Scraping_project/data/screenshots/
Scraping_project/data/warc/
Scraping_project/data/profiles/
Scraping_project/data/exports/*
!Scraping_project/data/exports/.gitkeep
Scraping_project/screenshots/
Scraping_project/profiles/
/screenshots/
*.warc
*.warc.gz
*.arc.gz
*.prof
*.pstats
*.cprofile
!**/tests/**/fixtures/**/*.warc
!**/tests/**/fixtures/**/*.warc.gz

