{
  "uid": "pipeline-slos",
  "title": "Pipeline SLOs",
  "description": "One panel per published SLO (#179). Targets and alerts: docs/guides/PIPELINE_SLOS.md.",
  "tags": ["scraping", "pipeline", "slo"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Pipeline SLOs",
      "id": 1,
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "type": "stat",
      "title": "Stage 2 success (24h)",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "SLO >= 99% of stage2_rows_total over 24h (issue #179). Recording rule stage2:success_ratio:24h. Threshold alert Stage2SuccessSLO fires when this is under 0.99 and the window had rows. Error budget is the other 1%.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "stage2:success_ratio:24h",
          "legendFormat": "accepted / all rows",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 0.99}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Redis queue depth",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "SLO threshold is unchanged: redis_queue_length > 10000 for 10m. High watermark 10000, low watermark 8000, mode block. QueueBacklog groups by queue and site_id so the annotation names the site (#192). This panel stays max by (queue) at the same 10000 line.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "max by (queue) (redis_queue_length)",
          "legendFormat": "{{queue}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 10000}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Kafka consumer lag",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "SLO is the existing KafkaConsumerLagSLO rule: max_over_time(kafka_consumergroup_lag_max[5m]) > 250000 messages for 15m. Not a minute target. The rule is not changed.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "max_over_time(kafka_consumergroup_lag_max[5m])",
          "legendFormat": "{{client_id}} {{topic}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "red", "value": 250000}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    }
  ]
}
