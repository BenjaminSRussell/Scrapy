# kafka-delta-ingest environment (#379). Copy to .env next to Cargo.toml.
# The binary loads .env on start (dotenv); a real environment variable wins.
# Never commit .env: the repo-root .gitignore ignores .env and .env.* except .env.example.
#
# Kafka, consumer group and table path are CLI arguments, not env vars:
#   cargo run --release -- ingest <TOPIC> <TABLE_PATH> --kafka localhost:9092 --app-id my-group
# (the container entrypoint only uses KAFKA_BOOTSTRAP_SERVERS to wait for the broker).

# Logging: error | warn | info | debug | trace   (optional, default info)
RUST_LOG=info

# StatsD metrics target (optional; defaults below). In the Helm/full stack this
# is the statsd-exporter service.
STATSD_HOST=localhost
STATSD_PORT=9125

# Redis (#511): the same contract as the Python services, Compose and Helm.
# REDIS_URL is only a fallback when REDIS_HOST is unset — do not set it in Helm.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Only for the container entrypoint's broker wait (optional):
# KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Not used by this build: S3 table paths need the deltalake `s3` feature (see README
# "S3 table paths"), so AWS_* variables have no effect until that is enabled.
