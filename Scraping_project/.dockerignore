# Docker ignore file to reduce build context

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/

# Documentation
docs/
*.md
!README.md

# IDE
.vscode/
.idea/
*.swp
*.swo

# Git
.git/
.gitignore

# Data and logs
data/
logs/
*.log

# Docker
Dockerfile
docker-compose.yml
.dockerignore

# CI/CD
.github/

# Monitoring: configs/dashboards stay out of the image; the exporter code ships
# for the `metrics` Dockerfile target (#449).
monitoring/*
!monitoring/__init__.py
!monitoring/metrics_exporter.py
!monitoring/metric_helpers.py

# Kubernetes
k8s/
