# PostgreSQL Configuration
# Copy this file to .env and fill in your database credentials.
# Values below use Compose service DNS for in-network containers.
# Host-side clients (apps on the host, not in Compose) should use localhost.

# Database connection settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=scraping_pipeline
DB_USER=postgres
# REQUIRED for streaming profile (Postgres). No default in docker-compose.yml.
DB_PASSWORD=your_secure_password_here

# Kafka (streaming profile; compose service DNS)
# Host-side clients: use localhost:9092 instead.
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Grafana admin credentials (monitoring profile)
# REQUIRED — no default in docker-compose.yml.
GRAFANA_ADMIN_PASSWORD=your_secure_grafana_password_here

# Notes:
# - DB_PASSWORD and GRAFANA_ADMIN_PASSWORD are REQUIRED (set in .env; compose has no fallbacks)
# - If DB_PASSWORD is not set, PostgreSQL logging will be disabled for the app; streaming Postgres will not start
# - The pipeline will still work without PostgreSQL (metrics won't be tracked)
# - Database schema will be auto-created on first connection
# - Start core+monitoring: docker compose --profile core --profile monitoring up -d
