# PostgreSQL Configuration
# Copy this file to .env and fill in your database credentials

# Database connection settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scraping_pipeline
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Kafka (streaming profile; matches config.yml bootstrap default)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Grafana admin credentials (monitoring profile)
# Override the compose default admin password in non-local environments
GRAFANA_ADMIN_PASSWORD=admin

# Notes:
# - DB_PASSWORD is REQUIRED for PostgreSQL features to work
# - If DB_PASSWORD is not set, PostgreSQL logging will be disabled
# - The pipeline will still work without PostgreSQL (metrics won't be tracked)
# - Database schema will be auto-created on first connection
# - Start core+monitoring: docker compose --profile core --profile monitoring up -d
