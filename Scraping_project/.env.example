# ============================================================================
# Scraping_project environment (#239). Copy to .env and edit:  cp .env.example .env
# docker compose reads .env automatically; the Python code reads the process env.
# Never commit .env (ignored by the repo-root .gitignore). See ../SECURITY.md.
#
#   [required]  the container/entrypoint fails without it
#   [optional]  has a default (shown); uncomment to override
# ============================================================================

# ---------------------------------------------------------------------------
# Redis — [required] by docker/entrypoints/crawler-entrypoint.sh
# (`: "${REDIS_HOST:?}"` and `: "${REDIS_PORT:?}"`). docker-compose.yml sets
# both for its containers (redis / 6379); set them yourself when running the
# entrypoint or workers outside Compose.
# ---------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
# Redis AUTH (#184). When set, docker-compose starts Redis with --requirepass
# and every app container authenticates with it. Leave empty ONLY for local
# dev (Redis is bound to 127.0.0.1; the app logs a warning). Helm always
# requires it (secrets.redis.password or the redis-credentials Secret).
REDIS_PASSWORD=
# [optional] seconds the entrypoint waits for Redis before failing
# REDIS_WAIT_TIMEOUT=120

# ---------------------------------------------------------------------------
# PostgreSQL — [optional] metrics/error sink. Without DB_PASSWORD the pipeline
# runs and Postgres logging is disabled.
# ---------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=scraping_pipeline
# The app connects as the least-privilege role created by docker/init-db.sql
# (#538), never as the superuser. docker-compose passes APP_DB_PASSWORD to both
# Postgres (role creation) and the workers (DB_PASSWORD).
DB_USER=scrapy_app
DB_PASSWORD=your_secure_password_here
APP_DB_PASSWORD=your_secure_password_here
# Postgres superuser for the compose `postgres` container, postgres-exporter and
# Grafana's datasource. Defaults to "postgres" for local dev only; change it
# before exposing the stack, and rotate it if it ever leaked (SECURITY.md).
POSTGRES_PASSWORD=change_me_postgres_superuser
# Notes:
# - The schema and the app role are created by docker/init-db.sql (run as the
#   superuser on first Postgres start, or re-run it to migrate an existing volume).
#   The app only creates tables itself when its role is allowed to.

# ---------------------------------------------------------------------------
# Kafka — [optional]. Core profile (docker-compose.yml) has no Kafka: leave
# KAFKA_BOOTSTRAP_SERVERS unset and the entrypoint skips the Kafka wait.
# Streaming profile (Helm) sets it. REQUIRE_KAFKA=1 makes it mandatory.
# ---------------------------------------------------------------------------
# KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# REQUIRE_KAFKA=0
# KAFKA_WAIT_TIMEOUT=120
# KAFKA_SECURITY_PROTOCOL=PLAINTEXT      # SASL_SSL in production
# KAFKA_SASL_MECHANISM=SCRAM-SHA-512
# KAFKA_SASL_USERNAME=
# KAFKA_SASL_PASSWORD=
# KAFKA_PRODUCER_ACKS=all
# KAFKA_REQUIRE_IDEMPOTENCE=false
# KAFKA_DLQ_ENABLED=true
# KAFKA_SPILL_DIR=data/kafka_spill

# ---------------------------------------------------------------------------
# Grafana — admin password for http://localhost:3000 (user: admin).
# "admin" is for local dev only; set a real one before sharing the host.
# ---------------------------------------------------------------------------
GRAFANA_ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Metrics ports — [optional]. Prometheus scrapes these inside the compose
# network (monitoring/prometheus.yml); they are not published to the host.
# ---------------------------------------------------------------------------
# Scrapy spiders: PROMETHEUS_PORT setting in src/settings.py (default 9410).
# WORKER_METRICS_PORT=9430          # Stage 2/3/4 workers (src/utils/worker_metrics.py)
# METRICS_EXPORTER_PORT=0           # monitoring/metrics_exporter.py (0 = disabled)
# STATSD_HOST=localhost             # StatsD target for the kafka-delta-ingest stack
# STATSD_PORT=8125

# ---------------------------------------------------------------------------
# Storage — [optional]
# ---------------------------------------------------------------------------
# DELTA_LAKE_PATH=./data/delta_lake  # wins over config.yml delta_lake.base_path; compose uses /data/delta

# ---------------------------------------------------------------------------
# Crawl politeness / safety — [optional] (docs/guides/CONFIGURATION.md)
# ---------------------------------------------------------------------------
# ROBOTSTXT_OBEY=true
# ROBOTS_MAX_CRAWL_DELAY=60
# RETRY_AFTER_MAX_DELAY=120
# SSRF_GUARD_ENABLED=1
# SSRF_RESOLVE_DNS=0
# SSRF_ALLOWED_HOSTS=
# ENV=development                    # "production" turns on the destructive-op guards

# ---------------------------------------------------------------------------
# OpenTelemetry tracing — [optional] (default off / no-op when unset)
# Requires: pip install -e ".[otel]"  (from Scraping_project/)
# Point at the collector from docker-compose.observability.yml
# ---------------------------------------------------------------------------
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_SERVICE_NAME=scrapy-pipeline
# CRAWL_JOB_ID=  # optional; auto-generated per spider/worker if unset

# ---------------------------------------------------------------------------
# Logging (#238, #466) — read by cli.py and the src.workers.stageN_worker entrypoints
# ---------------------------------------------------------------------------
# LOG_FORMAT=text   # text (default, human) | json (one JSON object per line, for Loki/OTel)
# LOG_LEVEL=INFO
# WORKER_ID=        # optional; defaults to <hostname>-<pid>. CRAWL_JOB_ID (above) is added to every line when set.

# ---------------------------------------------------------------------------
# Docker Compose CLI — [optional] (#342). start.py / shutdown.py use
# docker-compose if installed, else the `docker compose` plugin.
# ---------------------------------------------------------------------------
# COMPOSE_CMD="docker compose"
