# Stage 1: Build the project with dependencies
FROM python:3.10-slim as builder

WORKDIR /app

# Install poetry
RUN pip install poetry

# Copy dependency definition files from the project root
COPY pyproject.toml poetry.lock* ./

# Install dependencies
RUN if [ -f poetry.lock ]; then poetry install --without-groups dev; else poetry install --without-groups dev --no-root; fi

# Stage 2: Create the final image
FROM python:3.10-slim

WORKDIR /app

# Copy the installed dependencies from the builder stage
COPY --from=builder /app/.venv /.venv
ENV PATH="/app/.venv/bin:$PATH"

# Copy the application code required by the metrics exporter
COPY src ./src
COPY monitoring/. .

# Command to run the metrics exporter
CMD ["python", "metrics_exporter.py"]
