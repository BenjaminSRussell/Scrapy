{
  "uid": "org-customer-health",
  "title": "Customer success health by org",
  "description": "Admin view of org_customer_health_score (#966). Activity (pages crawled / 100, or finished jobs / 4) weight 0.4 plus finished-job success rate weight 0.6. No finished jobs means no series, not zero. OrgCustomerHealthLow warns under 0.5 for 30m. Not an SLO and not pipeline:health:score. Stage2SuccessSLO, QueueBacklog (> 10000), and KafkaConsumerLagSLO (> 250000) are unchanged.",
  "tags": ["scraping", "customer-success", "admin"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "30s",
  "time": {"from": "now-24h", "to": "now"},
  "templating": {
    "list": [
      {
        "name": "datasource",
        "label": "Datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {"text": "Prometheus", "value": "prometheus"},
        "hide": 0
      },
      {
        "name": "org",
        "label": "Org",
        "type": "query",
        "datasource": {"type": "prometheus", "uid": "${datasource}"},
        "query": {"query": "label_values(org_customer_health_score, org_id)", "refId": "org"},
        "definition": "label_values(org_customer_health_score, org_id)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {"text": "All", "value": "$__all"}
      }
    ]
  },
  "annotations": {"list": []},
  "panels": [
    {
      "type": "row",
      "title": "Customer success",
      "id": 1,
      "collapsed": false,
      "gridPos": {"h": 1, "w": 24, "x": 0, "y": 0},
      "panels": []
    },
    {
      "type": "stat",
      "title": "Health score",
      "id": 2,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "org_customer_health_score. Warning under 0.5 (OrgCustomerHealthLow). Not an SLO.",
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 1},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "org_customer_health_score{org_id=~\"$org\"}",
          "legendFormat": "{{org_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Activity",
      "id": 3,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "org_customer_health_activity. Full activity is 100 pages crawled in the window or 4 finished jobs, whichever factor is higher.",
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 1},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "org_customer_health_activity{org_id=~\"$org\"}",
          "legendFormat": "{{org_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Success rate",
      "id": 4,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "org_customer_health_success_ratio. Succeeded finished jobs over succeeded plus failed. Running and cancelled rows are not in the rate.",
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 1},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "org_customer_health_success_ratio{org_id=~\"$org\"}",
          "legendFormat": "{{org_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "green", "value": 0.5}
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false},
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "timeseries",
      "title": "Health score over time",
      "id": 5,
      "datasource": {"type": "prometheus", "uid": "${datasource}"},
      "description": "Same score as the stat. The 0.5 line is the warning, not an SLO.",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 9},
      "targets": [
        {
          "datasource": {"type": "prometheus", "uid": "${datasource}"},
          "expr": "org_customer_health_score{org_id=~\"$org\"}",
          "legendFormat": "{{org_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "custom": {"fillOpacity": 10}
        },
        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"]},
        "tooltip": {"mode": "multi"}
      }
    }
  ]
}
