          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 35,
      "title": "Pipeline Progress - Cumulative Records",
      "description": "Cumulative record count across all pipeline stages over time",
