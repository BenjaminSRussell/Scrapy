{
  "uid": "unified-uconn-pipeline",
  "title": "UConn Scraping Pipeline - Unified Dashboard",
  "description": "Comprehensive monitoring dashboard for the entire UConn scraping pipeline including Delta Lake, Redis, Postgres, Kafka, and Scrapy metrics",
  "tags": [
    "scraping",
    "pipeline",
    "monitoring",
    "delta-lake",
    "kafka",
    "redis",
    "postgres"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "version": 4,
  "editable": true,
  "schemaVersion": 38,
  "panels": [
    {
      "id": 1,
      "title": "Total URLs Processed",
      "description": "Total number of URLs discovered and processed by the pipeline",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "delta_lake_records{table=\"stage1_discovery\"}",
          "legendFormat": "URLs",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              },
              {
                "value": 1000,
                "color": "green"
              },
              {
                "value": 10000,
                "color": "yellow"
              }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Active Spiders",
      "description": "Number of currently active Scrapy spiders",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "expr": "sum(scrapy_spider_opened)",
          "legendFormat": "Spiders",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Delta Lake Total Records",
      "description": "Total number of records across all Delta Lake tables",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "delta_lake_total_records",
          "legendFormat": "Records",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 50000,
                "color": "yellow"
              },
              {
                "value": 100000,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Error Rate",
      "description": "Total errors logged in the pipeline",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "expr": "delta_lake_records{table=\"stage1_errors\"}",
          "legendFormat": "Errors",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "background",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 10,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 5,
      "title": "Live Scraping Activity - URLs Processed per Second",
      "description": "Real-time throughput showing URLs processed per second by each pipeline stage",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 4
      },
      "targets": [
        {
          "expr": "urls_processed_per_second{stage=\"stage1\"}",
          "legendFormat": "Stage 1: Discovery",
          "refId": "A"
        },
        {
          "expr": "urls_processed_per_second{stage=\"stage2\"}",
          "legendFormat": "Stage 2: Analysis",
          "refId": "B"
        },
        {
          "expr": "urls_processed_per_second{stage=\"stage3\"}",
          "legendFormat": "Stage 3: Summarization",
          "refId": "C"
        },
        {
          "expr": "urls_processed_per_second{stage=\"stage4\"}",
          "legendFormat": "Stage 4: Large Docs",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "auto",
            "axisPlacement": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        }
      }
    },
    {
      "id": 6,
      "title": "Spider Activity",
      "description": "Current spider status and activity metrics",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 4
      },
      "targets": [
        {
          "expr": "scrapy_spider_opened",
          "legendFormat": "{{spider}}",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "none",
        "colorMode": "value",
        "textMode": "name",
        "orientation": "vertical",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Stopped",
                  "color": "red"
                },
                "1": {
                  "text": "Running",
                  "color": "green"
                }
              }
            }
          ]
        }
      }
    },
    {
      "id": 7,
      "title": "Delta Lake Records by Table",
      "description": "Distribution of records across Delta Lake tables",
      "type": "piechart",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 0,
        "y": 12
      },
      "targets": [
        {
          "expr": "delta_lake_records",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value",
            "percent"
          ]
        },
        "pieType": "donut",
        "tooltip": {
          "mode": "single"
        },
        "displayLabels": [
          "name",
          "percent"
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 8,
      "title": "Delta Lake Storage Size by Table",
      "description": "Storage size in MB for each Delta Lake table",
      "type": "bargauge",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 8,
        "y": 12
      },
      "targets": [
        {
          "expr": "delta_lake_size_bytes / 1024 / 1024",
          "legendFormat": "{{table}}",
          "refId": "A"
        }
      ],
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 1,
          "color": {
            "mode": "continuous-GrYlRd"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 100,
                "color": "yellow"
              },
              {
                "value": 500,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "Stage Record Counts",
      "description": "Current record count for each pipeline stage",
      "type": "stat",
      "gridPos": {
        "h": 10,
        "w": 8,
        "x": 16,
        "y": 12
      },
      "targets": [
        {
          "expr": "delta_lake_records{table=\"stage1_discovery\"}",
          "legendFormat": "Stage 1",
          "refId": "A"
        },
        {
          "expr": "delta_lake_records{table=\"stage2_page_analysis\"}",
          "legendFormat": "Stage 2",
          "refId": "B"
        },
        {
          "expr": "delta_lake_records{table=\"stage3_summaries\"}",
          "legendFormat": "Stage 3",
          "refId": "C"
        },
        {
          "expr": "delta_lake_records{table=\"stage4_summaries\"}",
          "legendFormat": "Stage 4",
          "refId": "D"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "orientation": "vertical",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": {
            "mode": "palette-classic"
          }
        }
      }
    },
    {
      "id": 10,
      "title": "Redis Queue Depths",
      "description": "Current length of Redis message queues between pipeline stages",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 22
      },
      "targets": [
        {
          "expr": "redis_queue_length{queue=\"stage1_discovered_urls\"}",
          "legendFormat": "Stage 1 \u2192 Stage 2",
          "refId": "A"
        },
        {
          "expr": "redis_queue_length{queue=\"stage2_analyzed_pages\"}",
          "legendFormat": "Stage 2 \u2192 Stage 3",
          "refId": "B"
        },
        {
          "expr": "redis_queue_length{queue=\"stage2_large_docs\"}",
          "legendFormat": "Stage 2 \u2192 Stage 4",
          "refId": "C"
        },
        {
          "expr": "redis_queue_length{queue=\"stage1_js_render_pending\"}",
          "legendFormat": "JS Render Queue",
          "refId": "D"
        },
        {
          "expr": "redis_queue_length{queue=\"priority_queue\"}",
          "legendFormat": "Priority Queue",
          "refId": "E"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "auto"
          },
          "color": {
            "mode": "palette-classic"
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "title": "Kafka Consumer Lag",
      "description": "Consumer lag in records for Kafka consumers (correct metric: kafka_consumer_records_lag)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "targets": [
        {
          "expr": "kafka_consumer_records_lag{consumer=\"stage2_consumer\"}",
          "legendFormat": "Stage 2 Consumer",
          "refId": "A"
        },
        {
          "expr": "kafka_consumer_records_lag{consumer=\"stage3_consumer\"}",
          "legendFormat": "Stage 3 Consumer",
          "refId": "B"
        },
        {
          "expr": "kafka_consumer_records_lag{consumer=\"stage4_consumer\"}",
          "legendFormat": "Stage 4 Consumer",
          "refId": "C"
        },
        {
          "expr": "kafka_consumer_records_lag",
          "legendFormat": "{{consumer_group}}-{{topic}}-p{{partition}}",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15
          },
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 60,
                "color": "yellow"
              },
              {
                "value": 300,
                "color": "red"
              }
            ]
          }
        }
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 12,
      "title": "Redis Connections",
      "description": "Number of connected Redis clients",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 30
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Clients",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 50,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 13,
      "title": "Redis Memory Usage",
      "description": "Redis memory usage in MB",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 30
      },
      "targets": [
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Memory",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 512,
                "color": "yellow"
              },
              {
                "value": 1024,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 14,
      "title": "Redis Hit Rate",
      "description": "Redis cache hit rate percentage",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 30
      },
      "targets": [
        {
          "expr": "rate(redis_keyspace_hits_total[5m]) / (rate(redis_keyspace_hits_total[5m]) + rate(redis_keyspace_misses_total[5m])) * 100",
          "legendFormat": "Hit Rate",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "red"
              },
              {
                "value": 50,
                "color": "yellow"
              },
              {
                "value": 80,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 15,
      "title": "Redis Operations/sec",
      "description": "Redis operations per second",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 18,
        "y": 30
      },
      "targets": [
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "Ops/sec",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 16,
      "title": "Redis Metrics Over Time",
      "description": "Redis key performance metrics over time",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 34
      },
      "targets": [
        {
          "expr": "redis_connected_clients",
          "legendFormat": "Connections",
          "refId": "A"
        },
        {
          "expr": "redis_memory_used_bytes / 1024 / 1024",
          "legendFormat": "Memory (MB)",
          "refId": "B"
        },
        {
          "expr": "rate(redis_commands_processed_total[1m])",
          "legendFormat": "Commands/sec",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Memory (MB)"
            },
            "properties": [
              {
                "id": "unit",
                "value": "decmbytes"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Commands/sec"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              }
            ]
          }
        ]
      },
      "options": {
        "tooltip": {
          "mode": "multi"
        },
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 17,
      "title": "Postgres Connections",
      "description": "Active PostgreSQL database connections",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "expr": "pg_stat_activity_count",
          "legendFormat": "Connections",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 50,
                "color": "yellow"
              },
              {
                "value": 100,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 18,
      "title": "Postgres Query Rate",
      "description": "PostgreSQL queries per second",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 6,
        "y": 42
      },
      "targets": [
        {
          "expr": "rate(pg_stat_database_xact_commit[1m]) + rate(pg_stat_database_xact_rollback[1m])",
          "legendFormat": "Queries/sec",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              }
            ]
          }
        }
      }
    },
    {
      "id": 19,
      "title": "Postgres Database Size",
      "description": "Total PostgreSQL database size in MB",
      "type": "stat",
      "gridPos": {
        "h": 4,
        "w": 6,
        "x": 12,
        "y": 42
      },
      "targets": [
        {
          "expr": "pg_database_size_bytes / 1024 / 1024",
          "legendFormat": "Size",
          "refId": "A"
        }
      ],
      "options": {
        "graphMode": "area",
        "colorMode": "value",
        "textMode": "value_and_name",
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        }
      },
      "fieldConfig": {
