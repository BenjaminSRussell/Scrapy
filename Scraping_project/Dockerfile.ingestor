# ==================================================================
# Kafka to Delta Lake Ingestor Dockerfile
# ==================================================================
# This service consumes messages from Kafka and writes them to Delta Lake
# ==================================================================

FROM python:3.10-slim-bookworm

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
RUN pip install --no-cache-dir \
    confluent-kafka>=2.3.0 \
    deltalake>=1.1.0 \
    pyarrow>=17.0.0 \
    pandas>=2.0.0 \
    prometheus-client>=0.20.0 \
    python-dotenv>=1.0.0

# Create non-root user
RUN useradd -m -u 1000 ingestor && \
    chown -R ingestor:ingestor /app

# Copy ingestor script
COPY --chown=ingestor:ingestor src/consumers/kafka_delta_ingestor.py .

# Create necessary directories
RUN mkdir -p /data && \
    chown -R ingestor:ingestor /data

# Switch to non-root user
USER ingestor

# Expose Prometheus metrics port
EXPOSE 8001

# Run the ingestor
CMD ["python", "kafka_delta_ingestor.py"]
