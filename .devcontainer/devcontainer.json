{
  // Contributor dev environment (#321). Python 3.11 (CI matrix: 3.11 + 3.12),
  // docker-in-docker for the Compose stack, Rust for kafka-delta-ingest.
  "name": "Scrapy pipeline",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/devcontainers/features/rust:1": {"profile": "minimal"},
    "ghcr.io/devcontainers/features/node:1": {"version": "20"}
  },
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/Scraping_project",
  "postCreateCommand": "pip install --upgrade pip && pip install -r requirements.txt -r dev-requirements.txt -r ci-tools.txt && bash scripts/smoke_local.sh --no-tests",
  "containerEnv": {
    "PYTHONPATH": "/workspaces/${localWorkspaceFolderBasename}/Scraping_project:/workspaces/${localWorkspaceFolderBasename}/Scraping_project/src",
    "OBS_OFFLINE": "1"
  },
  "forwardPorts": [3000, 9090, 8000],
  "portsAttributes": {
    "3000": {"label": "Grafana"},
    "9090": {"label": "Prometheus"},
    "8000": {"label": "Control Center"}
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "charliermarsh.ruff", "rust-lang.rust-analyzer"]
    }
  }
}
